# ==================================================
# AI / MACHINE LEARNING SERVICES
# ==================================================

# Groq API
# Used for: Synapse AI Chat, Voice AI, and Resume ATS Analysis
GROQ_API_KEY=your_groq_api_key

# Hugging Face API
# Used for: AI Text Summarizer
HF_TOKEN=your_hf_api_key


# ==================================================
# DATABASE
# ==================================================

# MongoDB
# Used for: Users, authentication data, chat threads, and messages
MONGODB_URI=your_mongodb_connection_string


# ==================================================
# AUTHENTICATION
# ==================================================

# JWT Secret
# Used for: Creating and verifying Synapse AI login tokens
JWT_SECRET=your_jwt_secret

# Google OAuth / Google Identity
# Used for: Google Sign-In / Login
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID


# ==================================================
# EMAIL SERVICE
# ==================================================

# Gmail / SMTP
# Used for: Forgot-password and password-reset emails
EMAIL_USER=your_email
EMAIL_PASS=your_email_password


# ==================================================
# IMAGE / FILE SERVICES
# ==================================================

# Cloudinary
# Used for: User profile/avatar image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ClipDrop
# Used for: AI Image Generation / Imagify
CLIPDROP_API_KEY=your_clipdrop_api_key


# ==================================================
# FRONTEND
# ==================================================

# Frontend URL
# Used for: Backend/frontend application configuration
FRONTEND_URL=http://localhost:5173